# Copy to .env (git-ignored) and fill in. `make` reads it.

# Konnect personal access token: https://cloud.konghq.com/global/account/tokens
KONNECT_TOKEN=
# Konnect region of your organisation: eu, us, au, me, in
KONNECT_REGION=eu

# Port the gateway listens on (127.0.0.1 only). Change it if 8000 is already in use.
GATEWAY_PORT=8000

# Default model: served by Ollama in Docker, no key needed. Small enough to run on CPU, no GPU needed.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:0.5b
# CPU threads for the model. More is not faster inside Docker: one per CPU collapsed to about 1 token/s.
OLLAMA_NUM_THREAD=4

# Part 2 and later: Claude as the hosted model. A Claude API key from the Claude Console
# (https://platform.claude.com). Stored in Konnect by `make up`; apps never see it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Filled in by `make up` (the AI Gateway's id and its connection details)
AI_GATEWAY_ID=
KONG_CLUSTER_CONTROL_PLANE=
KONG_CLUSTER_SERVER_NAME=
KONG_CLUSTER_TELEMETRY_ENDPOINT=
KONG_CLUSTER_TELEMETRY_SERVER_NAME=

# The API key the shop app uses to call the gateway (`make up` creates one)
SHOP_APP_KEY=

# Optional Grafana stack (observability/): the Grafana admin password (`make up` there creates one)
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=
