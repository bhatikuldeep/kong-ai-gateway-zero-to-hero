# Copy to .env (git-ignored) and fill in. `make` reads it.

# Konnect personal access token: https://cloud.konghq.com/global/account/tokens
KONNECT_TOKEN=
# Konnect region of your organisation: eu, us, au, me, in
KONNECT_REGION=eu

# Local port for the gateway. Change it if something else on your machine already uses 8000.
GATEWAY_PORT=8000

# Default model: local Ollama, no key needed. A small model that runs on any laptop CPU.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:0.5b
# CPU threads for the model. More is not faster inside Docker: one per CPU collapsed to about 1 token/s.
OLLAMA_NUM_THREAD=4

# Filled in by `make up` (the AI Gateway's id and its connection details)
AI_GATEWAY_ID=
KONG_CLUSTER_CONTROL_PLANE=
KONG_CLUSTER_SERVER_NAME=
KONG_CLUSTER_TELEMETRY_ENDPOINT=
KONG_CLUSTER_TELEMETRY_SERVER_NAME=

# The API key the shop app uses to call the gateway (`make up` creates one)
SHOP_APP_KEY=
