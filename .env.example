# Copy to .env (git-ignored) and fill in. `make` reads it.

# Konnect personal access token: https://cloud.konghq.com/global/account/tokens
KONNECT_TOKEN=
# Konnect region of your organisation: eu, us, au, me, in
KONNECT_REGION=eu

# Default model: local Ollama, no key needed.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b

# Filled in by `make endpoints` (the AI Gateway's id and its data plane connection points)
AI_GATEWAY_ID=
KONG_CLUSTER_CONTROL_PLANE=
KONG_CLUSTER_SERVER_NAME=
KONG_CLUSTER_TELEMETRY_ENDPOINT=
KONG_CLUSTER_TELEMETRY_SERVER_NAME=

# The API key the shop app uses to call the gateway (`make key` generates one)
SHOP_APP_KEY=
