// Container logs: what Part 1's containers print (the data plane's error log, Ollama), read from Docker.
// Only containers of the acme-aigw compose project. Labels: container (kong, ollama) and stream.
discovery.docker "acme" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=acme-aigw"]
  }
}

discovery.relabel "acme" {
  targets = discovery.docker.acme.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "acme" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.acme.targets
  relabel_rules = discovery.relabel.acme.rules
  labels        = { source = "container" }
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
